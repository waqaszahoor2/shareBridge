# Recommended for production on Vercel. Add an Upstash Redis integration
# and keep both values server-side (do NOT prefix them with NEXT_PUBLIC_).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional ICE server overrides. Google STUN is used if blank.
NEXT_PUBLIC_STUN_URL=stun:stun.l.google.com:19302
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
