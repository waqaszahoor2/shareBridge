# Recommended for production on Vercel. Add an Upstash Redis integration
# and keep both values server-side (do NOT prefix them with NEXT_PUBLIC_).
UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# Optional ICE server overrides. Google STUN is used if blank.
NEXT_PUBLIC_STUN_URL=stun:stun.l.google.com:19302

# Required for reliable cross-network transfers. Configure a TURN provider (for example, Coturn
# with TURN REST API credentials). Include UDP and TCP/TLS URLs where your provider supports them.
# The app automatically uses relay candidates if a direct device-to-device path is blocked.
# Used by /api/turn-credentials to generate short-lived credentials without exposing the shared secret.
TURN_SECRET=your_coturn_static_auth_secret_or_turn_shared_secret
TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:443?transport=tcp

# Static TURN credentials (alternative to TURN_SECRET/TURN_URLS; these are public to browser clients)
NEXT_PUBLIC_TURN_URL=turn:turn.example.com:3478
NEXT_PUBLIC_TURN_USERNAME=turnuser
NEXT_PUBLIC_TURN_CREDENTIAL=turnpassword

# Test / Debug Mode: Force TURN Relay Connection (set to "true" to test TURN relay fallback)
NEXT_PUBLIC_FORCE_TURN=false
